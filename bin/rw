#!/usr/bin/env bash
# rw - mount the Chrome OS filesystem read/write.
# Thin entry point; the implementation lives in ../lib/cmd_rw.sh.
set -Eeuo pipefail

cbs_src="${BASH_SOURCE[0]}"
while [[ -L "${cbs_src}" ]]; do
  cbs_dir="$(cd -P "$(dirname "${cbs_src}")" && pwd)"
  cbs_src="$(readlink "${cbs_src}")"
  [[ "${cbs_src}" == /* ]] || cbs_src="${cbs_dir}/${cbs_src}"
done
CBS_ROOT_DIR="$(cd -P "$(dirname "${cbs_src}")/.." && pwd)"
CBS_LIB_DIR="${CBS_ROOT_DIR}/lib"
CBS_CMD_NAME="rw"

# shellcheck source=lib/common.sh
. "${CBS_LIB_DIR}/common.sh"
# shellcheck source=lib/cmd_rw.sh
. "${CBS_LIB_DIR}/cmd_rw.sh"

cbs_main "$@"
